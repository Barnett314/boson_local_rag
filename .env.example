# =============================================
# Boson RAG 環境設定範本
# 使用方式：複製為 .env 後填入實際值
#   cp .env.example .env
# =============================================

# === 筆記資料夾路徑（必填）===
# 支援多個路徑，用逗號分隔
# macOS Obsidian 預設位置範例：
VAULT_PATHS=/Users/你的名字/Documents/MyVault
# 多資料夾範例：
# VAULT_PATHS=/Users/你的名字/Documents/Work,/Users/你的名字/Documents/Personal

# === AI 供應商金鑰（br ask 才需要，br find 不需要）===
DEEPSEEK_API_KEY=你的_DeepSeek_API_Key
# OPENAI_API_KEY=你的_OpenAI_API_Key（選填）
